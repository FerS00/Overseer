<Application x:Class="Overseer.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <!-- Dark-only tokens from design-system/agent-ops/DESIGN.md. -->
    <SolidColorBrush x:Key="Surface" Color="#11151F" />
    <SolidColorBrush x:Key="Surface2" Color="#171C29" />
    <SolidColorBrush x:Key="Stage" Color="#0D1119" />
    <SolidColorBrush x:Key="Line" Color="#222A3B" />
    <SolidColorBrush x:Key="LineStrong" Color="#6E7A96" />
    <SolidColorBrush x:Key="Fg" Color="#E8ECF4" />
    <SolidColorBrush x:Key="Muted" Color="#98A2B8" />
    <SolidColorBrush x:Key="Brand" Color="#A99BFF" />
    <SolidColorBrush x:Key="OnBrand" Color="#0A0D14" />
    <SolidColorBrush x:Key="Ring" Color="#C9C2FF" />
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="Body">Segoe UI Variable Text, Segoe UI</FontFamily>
    <BooleanToVisibilityConverter x:Key="Visible" />

    <!-- Dark context menus for the bar (the tray menu uses the Windows look). -->
    <Style TargetType="ContextMenu">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="HasDropShadow" Value="False" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="FontFamily" Value="{StaticResource Body}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="12" Padding="4" MinWidth="220">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="8,6" Margin="0,1">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="Check" Text="✓" Foreground="{StaticResource Brand}" FontWeight="Bold" Visibility="Hidden" VerticalAlignment="Center" />
                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{StaticResource Muted}" FontFamily="{StaticResource Mono}" FontSize="11" Margin="16,0,0,0" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible" /></Trigger>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Separator">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator"><Rectangle Height="1" Fill="{StaticResource Line}" Margin="8,4" /></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MenuSection" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Mono}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="Margin" Value="12,6,12,4" />
    </Style>

    <!-- Thin scroll bar for the flyout. -->
    <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="MinWidth" Value="8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Width="6" HorizontalAlignment="Center">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="{StaticResource LineStrong}" Opacity=".75" /></ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>

# Copy to .env. H2 is the default; set all AGENT_OPS_DB_* values to use MySQL.
AGENT_OPS_PORT=8787
AGENT_OPS_BIND=127.0.0.1
AGENT_OPS_CORS=http://localhost:4200,http://127.0.0.1:4200
AGENT_OPS_RETENTION_DAYS=14
# Compose stores the generated token alongside the mounted local events directory.
AGENT_OPS_TOKEN_FILE=/events/token
# AGENT_OPS_DB_URL=jdbc:mysql://localhost:3306/agentops?serverTimezone=UTC
# AGENT_OPS_DB_USER=agentops
# AGENT_OPS_DB_PASS=
# AGENT_OPS_DB_DRIVER=com.mysql.cj.jdbc.Driver

# Host directories mounted by Docker Compose; rollouts are read-only in the container.
AGENT_OPS_EVENTS_DIR=./.agent-ops
AGENT_OPS_CODEX_SESSIONS_DIR=./.codex-sessions
AGENT_OPS_CODEX_WATCHER_ENABLED=true
# Docker cannot see host installations unless their folders are mounted. Set a
# comma-separated override, e.g. AGENT_OPS_AGENTS=claude,codex, or mount markers.
# AGENT_OPS_AGENTS=claude,codex

# Optional Docker-only MySQL settings. Use a new, empty database; for a host database
# from Docker Desktop, use host.docker.internal instead of localhost.
# AGENT_OPS_DOCKER_DB_URL=jdbc:mysql://host.docker.internal:3306/agentops?serverTimezone=UTC
# AGENT_OPS_DOCKER_DB_USER=agentops
# AGENT_OPS_DOCKER_DB_PASS=
# AGENT_OPS_DOCKER_DB_DRIVER=com.mysql.cj.jdbc.Driver
